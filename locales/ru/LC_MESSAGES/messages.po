#: member_team.py:121
#, fuzzy
msgid "member_team_summary"
msgstr ""
"<b>Команда {{title}}</b> {{\"/m\" if as_admin else \"\"}}{{teamIdStr}}\n"
"<i>{{description}}</i>\n"
"Набрано Участников: {{totalMembers}}\n"
"{% if totalMembers < minimalMembers %}Необходимо набрать ещё <b>{{ "
"minimalMembers - totalMembers }}</b> участников\n"
"{% endif %}{% if maximalMembers > 0 and totalMembers >= maximalMembers "
"%}<b>Команда набрана!</b> {% if not suspendWaitingQueue %}Но вы можете "
"вступить в список ожидания.{% endif +%}\n"
"{% endif %}{% if deadline %}{% if deadlineDaysLeft >= 0 %}До крайнего "
"срока {{deadline.date()}} осталось <b>{{deadlineDaysLeft}} дней</b>!\n"
"{% else %} Крайний срок пропущен {{-deadlineDaysLeft}} дней назад.\n"
"{% endif %}{% endif %}----------------\n"
"{% if crews %}<b>Экипажи Команды:</b>\n"
"{% for crew in crews %}{{crew.title}} {% if crew.as_leader %} "
"/mc{{crew.crewIdStr}} {% endif +%}\n"
"{% for mate in crew.mates %}{{loop.index}} : {{mate.userName}} {% if "
"mate.number > 0 %} (+{{mate.number}}) {% endif +%}\n"
"{% endfor %}\n"
"Вступить в Экипаж /c{{crew.crewIdStr}}\n"
"\n"
"{% endfor %}\n"
"{% endif %}{% if members %}<b>Участники команды:</b>\n"
"{% for member in members %}{{member.position + 1}}: {{member.userName}} "
"{% if member.number > 0 %}(+{{member.number}}){% endif +%}\n"
"{% endfor +%}---------------\n"
"{% endif %}{% if defaultCrew.mates %}<b>Ожидающие места в экипажах:</b>\n"
"{% for mate in defaultCrew.mates %}{{loop.index}} : {{mate.userName}} {% "
"if mate.number > 0 %} (+{{mate.number}}) {% endif +%}\n"
"{% endfor %}---------------\n"
"{% endif %}<b>Список ожидающих:</b>---------------\n"

