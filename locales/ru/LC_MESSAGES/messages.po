#: member_team.py:96
#, fuzzy
msgid "member_team_summary"
msgstr ""
"Команда {{\"/m\" if as_admin else \"\"}}{{teamId}}: <b>{{title}}</b>\n"
"<i>{{description}}</i>\n"
"{% if totalMembers < minimalMembers %}<b>Команда не набрана.</b> "
"Необходимо набрать ещё {{ minimalMembers - totalMembers }} участников\n"
"{% endif %}{% if totalMembers > 0 and totalMembers >= maximalMembers "
"%}<b>Команда набрана!</b> {% if not suspendWaitingQueue %}Но вы можете "
"вступить в список ожидания.{% endif %}\n"
"{% endif %}{% if deadline %} До крайнего срока {{deadline}} осталось "
"{{deadlineLeft}}\n"
"{% endif %}<b>Экипажи Команды:</b>\n"
"{% for crew in crews %}"
"{% if crew.crew.special == 0 %}"
"{{crew.crew.title}}\n"
"{% for mate in crew.mates %}"
"{{mate.position + 1}} : {{mate.userName}}\n"
"{% endfor %}\n"
"{% endif %}"
"{% endfor %}\n"
"Участники команды:\n"
"{% for member in members %}{{member.position + 1}}: {{member.userName}} "
"{% if member.number > 0 %}(+{{member.number}}){% endif +%}\n"
"{% endfor %}"

