#: teamlimits/user/tgbot/member_team.py:124
#, fuzzy
msgid "member_team_summary"
msgstr ""
"<b>Команда {{title}}</b> {{memberIdStr}}\n"
"<i>{{description or \"не задано\"}}</i>\n"
"Заявлено Участников: {{totalMembers}}\n"
"{% if membersLeft %}Необходимо набрать ещё <b>{{ membersLeft }}</b> "
"участников\n"
"{% endif %}{% if teamIsFull %}<b>Команда набрана!</b> {% if not "
"suspendWaitingQueue %}Но вы можете вступить в список ожидания.{% endif "
"+%}\n"
"{% endif %}{% if deadline %}{% if deadlineDaysLeft >= 0 %}До крайнего "
"срока {{deadline.date()}} осталось <b>{{ deadlineDaysLeft }} дн.</b>!\n"
"{% else +%}<b>Крайний срок пропущен {{ -deadlineDaysLeft }} дн. "
"назад.</b>{% endif %}{% endif +%}\n"
"\n"
"{% if hasCrews %}<b>Экипажи Команды:</b>\n"
"{% for crew in activeCrews %}{{crew.title}} {{ crew.mateIdStr }}\n"
"{% for mate in crew.activeMates %}{{loop.index}} : {{mate.userIdStr}}\n"
"{% endfor %}\n"
"{% if crew.queuedCrews %} Ожидающие:\n"
"{% for mate in crew.queuedMates %}{{crew.activeMates|length + "
"loop.index}} : {mate.userIdStr}{% endfor %}{% endif %}Вступить в Экипаж "
"/c{{crew.crewIdStr}}\n"
"\n"
"{% endfor %}\n"
"\n"
"<i><b>Ожидающие Экипажи:</b>\n"
"{% for crew in queuedCrews %}{{crew.title}} {{ crew.mateIdStr }}\n"
"{% for mate in crew.activeMates %}{{loop.index}} : {{mate.userIdStr}}\n"
"{% endfor %}\n"
"{% if crew.queuedMates %} Ожидающие:\n"
"{% for mate in crew.queuedMates %}{{crew.activeCrews|length + "
"loop.index}} : {{mate.userIdStr}}{% endfor %}{% endif %}Вступить в Экипаж"
" /c{{crew.crewIdStr}}\n"
"\n"
"{% endfor %}\n"
"</i>\n"
"{% endif %}{% if outboards %}<b>Участники команды:</b>\n"
