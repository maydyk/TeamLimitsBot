#: teamlimits/user/tg_bot/manage_team.py:640
#, fuzzy
msgid "manage_team_summary"
msgstr ""
"<u>Сводка Команды</u>{% if teamIdStr %} <b>{{teamIdStr}}</b>{% endif +%}\n"
"\n<b>Название:</b>\n{{title}}"
"\n{% if description +%}<b>Описание:</b>\n<i>{{description}}</i>"
"{% endif +%}\n"
"\n<b>Минимально участников:</b> {{minimalMembers or \"не задано\"}}"
"\n<b>Максимально участников:</b> {{maximalMembers or \"не задано\"}}"
"{% if enableCrews +%}"
"\n<b>Минимально Экипажей:</b> {{minimalCrews or \"не задано\"}}"
"\n<b>Максимально Экипажей:</b> {{maximalCrews or \"не задано\"}}"
"{% else +%}\n<b>Экипажи задаются администратором</b>{% endif +%}"
"{% if deadline +%}\n<b>Крайний Срок</b>: {{ deadline.date() }}{% endif +%}"
"\n<b>Остановить набор Домочадцев:</b> {{ \"Да!\" if suspendCompanions "
"else \"Нет\"}}"
"\n<b>Остановить набор Участников:</b> {{ \"Да!\" if "
"suspendRecruitment else \"Нет\" }}"
"{% if deadline %}\n<b>Останов. после Крайнего Ср.</b>: {{ \"Да!\" if suspendOnDeadline "
"else \"Нет\" }}{% endif %}"

