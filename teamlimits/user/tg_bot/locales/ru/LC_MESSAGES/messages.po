msgid "create_team_summary"
msgstr ""
"<u>Сводка Команды</u>{% if teamIdStr %} <b>{{teamIdStr}}</b>{% endif %}:\n"
"\n"
"<b>Название</b>:\n"
"{{title}}\n"
"{% if description +%}<b>Описание</b>:\n"
"{{description}}\n"
"{% endif %}<b>Минимально участников</b> : {{minimalMembers or \"не "
